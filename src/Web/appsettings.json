{
  "ConnectionStrings": {
    "Stubby": "Host=localhost;Database=stubby;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiGateway": {
    "Model": "gemma4:31b",
    "Models": [
      { "Name": "gemma4:31b", "Provider": "OllamaCloud" }
    ],
    "OllamaCloud": {
      "BaseUrl": "https://ollama.com",
      "ApiKey": ""
    },
    "TimeoutBaseSeconds": 30,
    "TimeoutPerImageSeconds": 15,
    "RateLimitPerMinute": 30,
    "RateLimitBurst": 5,
    "CircuitFailureThreshold": 5,
    "CircuitSamplingSeconds": 300,
    "CircuitBreakSeconds": 60
  },
  "ImageStorage": {
    "RootPath": "data/images"
  },
  "AllowedHosts": "*"
}
