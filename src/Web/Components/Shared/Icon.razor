    {
        ["inbox"] = "<path d=\"M4 13l2-8h12l2 8M4 13v6h16v-6M4 13h5l1 2h4l1-2h5\"/>",
        ["receipt"] = "<path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2V3zM9 8h6M9 12h6\"/>",
        ["chart"] = "<path d=\"M4 20V11M10 20V4M16 20v-8M21 20H3\"/>",
        ["plus"] = "<path d=\"M12 5v14M5 12h14\"/>",
        ["camera"] = "<path d=\"M4 8h3l2-3h6l2 3h3v11H4zM12 17a4 4 0 100-8 4 4 0 000 8z\"/>",
        ["search"] = "<circle cx=\"11\" cy=\"11\" r=\"6\"/><path d=\"M20 20l-4-4\"/>",
        ["left"] = "<path d=\"M15 6l-6 6 6 6\"/>",
        ["right"] = "<path d=\"M9 6l6 6-6 6\"/>",
        ["down"] = "<path d=\"M6 9l6 6 6-6\"/>",
