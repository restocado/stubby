        ["fit"] = "<path d=\"M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5\"/>",
        ["upload"] = "<path d=\"M12 16V5M7 10l5-5 5 5M5 19h14\"/>",
        ["file"] = "<path d=\"M7 3h7l5 5v13H7zM14 3v5h5\"/>",
