@page "/upload"
@rendermode InteractiveServer
@using Mediator
@using Stubby.Application.Features.Receipts.UploadReceipt
@using Stubby.Domain.Receipts
@inject IMediator Sender
@inject ILogger<Upload> Logger

<PageTitle>Add receipts</PageTitle>

<header class="page-head">
    <div>
        <h1>Add receipts</h1>
        <p>They are read in the background, so you can keep adding.</p>
    </div>
</header>

<div class="intake">
    @* The file input covers the whole zone, so a click anywhere opens the chooser and a drop anywhere lands on it. *@
    <div class="panel dropzone @(_busy ? "busy" : "")">
        <InputFile class="dropzone-input"
                   OnChange="OnFilesChosen"
                   multiple
                   accept="image/jpeg,image/png,application/pdf"
                   disabled="@_busy"
                   aria-label="Choose receipts to add" />
        <div class="empty-icon"><Icon Name="upload" Class="large" /></div>
        <h2><span class="drop-hint">Drop receipts here</span><span class="drop-hint-phone">Choose photos or files</span></h2>
        <p class="muted">JPG, PNG or PDF, up to 10 MB each. Several at once is fine.</p>
        <span class="button primary large">Choose files</span>
    </div>

    @* A phone opens its camera for this one. *@
    <label class="button primary large camera @(_busy ? "disabled" : "")">
        <Icon Name="camera" Class="large" /> Take a photo
        <InputFile class="camera-input"
                   OnChange="OnFilesChosen"
                   accept="image/*"
                   capture="environment"
                   disabled="@_busy"
                   aria-label="Take a photo of a receipt" />
    </label>
</div>

@if (_results.Count > 0)
{
    <section class="batch">
        <h2 class="section-title">This batch <span>@(_results.Count == 1 ? "1 file" : $"{_results.Count} files")</span></h2>
        <div class="panel files">
            @foreach (var result in _results)
            {
                <div class="file" @key="result">
                    <div class="file-icon @result.IconClass"><Icon Name="file" /></div>
                    <div class="file-main">
                        <div class="file-name">@result.FileName</div>
                        <div class="muted">@result.Message</div>
                    </div>
                    @switch (result.Outcome)
                    {
                        case Outcome.Sending:
                            <span class="chip chip-read"><span class="spinner"></span>Sending</span>
                            break;
                        case Outcome.Added:
                            <span class="chip chip-ok"><Icon Name="check" Class="small" />Added</span>
                            break;
                        case Outcome.Duplicate:
                            <span class="chip chip-warn">Already there</span>
                            break;
                        default:
                            <span class="chip chip-fail">Skipped</span>
                            break;
                    }
                </div>
            }
        </div>

        @if (!_busy)
        {
            <div class="batch-footer">
                <span class="muted">@Summary()</span>
                <a class="button primary large" href="">Go to inbox <Icon Name="arrow" /></a>
            </div>
        }
    </section>
}

@code {
    private const int MaxFilesPerBatch = 100;

    private readonly List<FileResult> _results = [];
    private bool _busy;

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        _busy = true;
        _results.Clear();

        try
        {
            foreach (var file in e.GetMultipleFiles(MaxFilesPerBatch))
            {
                var result = new FileResult(file.Name);
                _results.Add(result);
                StateHasChanged();

                await UploadAsync(file, result);
                StateHasChanged();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync(IBrowserFile file, FileResult result)
    {
        try
        {
            // One byte over the limit, so an oversized file comes back as TooLarge and does not throw.
            await using var content = file.OpenReadStream(Receipt.MaxFileSizeBytes + 1);
            var response = await Sender.Send(
                new UploadReceiptCommand(file.Name, file.ContentType, file.Size, content),
                CancellationToken.None);

            switch (response)
            {
                case UploadReceiptResponse.Created:
                    result.Set(Outcome.Added, "Added. Being read now.");
                    break;
                case UploadReceiptResponse.Duplicate d:
                    result.Set(Outcome.Duplicate, $"Already added as {TransactionNumber.Format(d.ExistingTransactionNo)}.");
                    break;
                case UploadReceiptResponse.UnsupportedType:
                    result.Set(Outcome.Skipped, "Not supported. Use a JPG, PNG or PDF file.");
                    break;
                case UploadReceiptResponse.TooLarge:
                    result.Set(Outcome.Skipped, "Too large. The limit is 10 MB.");
                    break;
                case UploadReceiptResponse.Empty:
                    result.Set(Outcome.Skipped, "The file is empty.");
                    break;
                default:
                    throw new InvalidOperationException($"Unhandled response {response.GetType().Name}.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload of {FileName} failed.", file.Name);
            result.Set(Outcome.Skipped, "Could not upload this file. Try again.");
        }
    }

    private string Summary()
    {
        var parts = new List<string>();
        AddPart(parts, Outcome.Added, "added");
        AddPart(parts, Outcome.Duplicate, "already there");
        AddPart(parts, Outcome.Skipped, "skipped");
        return string.Join(" · ", parts);
    }

    private void AddPart(List<string> parts, Outcome outcome, string text)
    {
        var count = _results.Count(r => r.Outcome == outcome);
        if (count > 0)
        {
            parts.Add($"{count} {text}");
        }
    }

    private enum Outcome { Sending, Added, Duplicate, Skipped }

    private sealed class FileResult(string fileName)
    {
        public string FileName { get; } = fileName;
        public Outcome Outcome { get; private set; } = Outcome.Sending;
        public string Message { get; private set; } = "Sending...";

        public string IconClass => Outcome switch
        {
            Outcome.Duplicate => "warn",
            Outcome.Skipped => "fail",
            _ => "",
        };

        public void Set(Outcome outcome, string message) => (Outcome, Message) = (outcome, message);
    }
}
