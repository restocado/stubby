@page "/receipts/{Id:guid}"
@rendermode InteractiveServer
@using System.Globalization
@using Mediator
@using Stubby.Application.Features.Receipts.ApproveReceipt
@using Stubby.Application.Features.Receipts.GetReceiptForReview
@using Stubby.Domain.Receipts
@inject IMediator Sender
@inject NavigationManager Navigation
@inject ILogger<ReviewReceipt> Logger

<PageTitle>Review receipt</PageTitle>

@switch (_state)
{
    case State.Loading:
        <p>Loading...</p>
        break;

    case State.NotFound:
        <h1>Receipt not found</h1>
        <p>There is no such receipt. <a href="receipts">Back to the receipts</a>.</p>
        break;

    case State.Locked:
        <h1>Still being read</h1>
        <p>This receipt is still being read. Try again in a moment. <a href="receipts">Back to the receipts</a>.</p>
        break;

    case State.Failed:
        <div class="alert alert-danger" role="alert">Could not load this receipt. <a href="receipts/@Id">Try again</a>.</div>
        break;

    case State.Ready:
        var receipt = _receipt!;
        var isApproved = receipt.Status == ReceiptStatus.Approved;
        var isFailed = receipt.Status == ReceiptStatus.Failed;
        var imageUrl = $"api/receipts/{receipt.Id}/image";

        <a class="btn btn-outline-secondary btn-sm mb-3" href="receipts">&larr; Back to the receipts</a>

        <h1>@TransactionNumber.Format(receipt.TransactionNo)</h1>
        <p class="text-muted text-break">@receipt.OriginalFileName</p>

        @if (isApproved)
        {
            <div class="alert alert-success" role="status">This receipt is approved and can no longer be changed.</div>
        }
        else if (isFailed)
        {
            <div class="alert alert-danger" role="alert">
                Stubby could not read this receipt (@receipt.LastError). Enter the details yourself.
            </div>
        }
        else if (receipt.IsFlagged)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Please check this receipt.</strong>
                <ul class="mb-0">
                    @foreach (var reason in receipt.FlagReasons)
                    {
                        <li>@FlagReasonText.Describe(reason)</li>
                    }
                </ul>
            </div>
        }

        @if (_conflict)
        {
            <div class="alert alert-warning" role="alert">
                This receipt can no longer be approved. It may have been approved in another tab. <a href="receipts">Back to the receipts</a>.
            </div>
        }

        @if (_saveError is not null)
        {
            <div class="alert alert-danger" role="alert">@_saveError</div>
        }

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                @if (receipt.ContentType == "application/pdf")
                {
                    <iframe src="@imageUrl" title="Receipt @TransactionNumber.Format(receipt.TransactionNo)" class="w-100 border" style="height: 70vh"></iframe>
                    <p class="mt-2"><a href="@imageUrl" target="_blank" rel="noopener">Open the PDF in a new tab</a></p>
                }
                else
                {
                    <img src="@imageUrl" alt="Receipt @TransactionNumber.Format(receipt.TransactionNo)" class="img-fluid border" />
                }
            </div>

            <div class="col-12 col-lg-6">
                @if (isApproved)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Merchant</dt>
                        <dd class="col-sm-8">@receipt.Merchant</dd>
                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@receipt.ReceiptDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</dd>
                        <dt class="col-sm-4">Total</dt>
                        <dd class="col-sm-8">@receipt.Total?.ToString("F2", CultureInfo.InvariantCulture)</dd>
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@receipt.Category?.ToString().ToLowerInvariant()</dd>
                    </dl>
                    <a class="btn btn-secondary" href="receipts">Back to the receipts</a>
                }
                else
                {
                    <EditForm Model="_form" OnSubmit="ApproveAsync" FormName="review">
                        <div class="mb-3">
                            <label class="form-label" for="merchant">Merchant</label>
                            <InputText id="merchant" class="form-control" @bind-Value="_form.Merchant" />
                            <FieldMessage Errors="_errors" Field="Merchant" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="date">Date</label>
                            <InputDate TValue="DateOnly?" id="date" class="form-control" @bind-Value="_form.Date" />
                            <FieldMessage Errors="_errors" Field="Date" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="total">Total</label>
                            <InputNumber TValue="decimal?" id="total" class="form-control" @bind-Value="_form.Total" />
                            <FieldMessage Errors="_errors" Field="Total" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="category">Category</label>
                            <InputSelect TValue="ReceiptCategory?" id="category" class="form-select" @bind-Value="_form.Category">
                                <option value="">Choose a category</option>
                                @foreach (var category in Enum.GetValues<ReceiptCategory>())
                                {
                                    <option value="@category">@category.ToString().ToLowerInvariant()</option>
                                }
                            </InputSelect>
                            <FieldMessage Errors="_errors" Field="Category" />
                        </div>
                        <p class="text-muted">Nothing is saved until you approve.</p>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">Approve</button>
                        <a class="btn btn-link" href="receipts">Cancel</a>
                    </EditForm>
                }
            </div>
        </div>
        break;
}

@code {
    private enum State { Loading, NotFound, Locked, Failed, Ready }

    private sealed class EditModel
    {
        public string? Merchant { get; set; }
        public DateOnly? Date { get; set; }
        public decimal? Total { get; set; }
        public ReceiptCategory? Category { get; set; }
    }

    private State _state = State.Loading;
    private ReceiptForReview? _receipt;
    private EditModel _form = new();
    private Dictionary<string, string> _errors = [];
    private string? _saveError;
    private bool _conflict;
    private bool _saving;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = State.Loading;
        try
        {
            switch (await Sender.Send(new GetReceiptForReviewQuery(Id)))
            {
                case GetReceiptForReviewResponse.Found found:
                    _receipt = found.Receipt;

                    // A ForReview receipt starts with what was read. A Failed one starts empty, as a manual entry.
                    _form = new EditModel
                    {
                        Merchant = found.Receipt.ExtractedMerchant,
                        Date = found.Receipt.ExtractedDate,
                        Total = found.Receipt.ExtractedTotal,
                    };
                    _state = State.Ready;
                    break;
                case GetReceiptForReviewResponse.Locked:
                    _state = State.Locked;
                    break;
                default:
                    _state = State.NotFound;
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load receipt {Id}.", Id);
            _state = State.Failed;
        }
    }

    private async Task ApproveAsync()
    {
        _saving = true;
        _errors = [];
        _saveError = null;
        _conflict = false;
        try
        {
            var response = await Sender.Send(new ApproveReceiptCommand(Id, _form.Merchant, _form.Date, _form.Total, _form.Category));
            switch (response)
            {
                case ApproveReceiptResponse.Approved:
                    Navigation.NavigateTo("receipts");
                    return;
                case ApproveReceiptResponse.Invalid invalid:
                    _errors = invalid.Errors.ToDictionary(e => e.Field, e => e.Message);
                    break;
                case ApproveReceiptResponse.NotFound:
                    _state = State.NotFound;
                    break;
                default:
                    _conflict = true;
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not approve receipt {Id}.", Id);
            _saveError = "Could not approve this receipt. Try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}
