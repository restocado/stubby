<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- The same secrets as the web app, so that the run command uses the same API key. -->
    <UserSecretsId>stubby-web-6d1f2a54-8b3e-4c7a-9f10-2e5b7c3d4a98</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Stubby.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Stubby.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web app's own settings file, so that the model, limits and prompt settings are the app's. -->
    <None Include="..\Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stubby.Eval.Tests" />
  </ItemGroup>

</Project>
